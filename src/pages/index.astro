---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
const documents = (await getCollection("publications"))
  .filter((doc) => doc.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Home"
  description="Robeson: A Texas interscholastic competition project."
>
  <section class="intro">
    <p class="eyebrow">Standards · Research · Public policy</p>
    <h1>
      Interscholastic competition.
      <br />A common standard.
    </h1>
    <p class="lead">
      A home for the Interscholastic Standard and research on home-school
      participation in Texas academic, artistic, and athletic competition.
    </p>
    <p>
      Newton Prep is the first reference implementation. Robeson houses the
      broader standards and policy work.
    </p>
  </section>
  <section class="robeson-introduction" aria-labelledby="paul-robeson">
    <figure class="historical-photo">
      <img
        src="/images/robeson/portrait.webp"
        alt="Paul Robeson smiling, seated in a suit and tie."
        width="960"
        height="1196"
        decoding="async"
      />
      <figcaption>
        Gordon Parks, 1942 · Library of Congress.
        <br />
        <a href="https://commons.wikimedia.org/wiki/File:Paul_Robeson_1942_crop.jpg">
          Public-domain photograph
        </a>
        .
      </figcaption>
    </figure>
    <div>
      <p class="eyebrow">The inspiration for our name</p>
      <h2 id="paul-robeson">Paul Robeson</h2>
      <p class="life-dates">1898–1976</p>
      <p>
        Scholar, athlete, singer, actor, and advocate for equality, Paul Robeson
        brought extraordinary gifts to many fields. He graduated from Rutgers as
        valedictorian, earned All-American honors in football, and became an
        internationally acclaimed performer.
      </p>
      <p>
        His example reflects the breadth of opportunity we want for students:
        the chance to excel in scholarship, the arts, and athletics.
      </p>
      <a class="read-more" href="/about/">
        Read about his life and this project →
      </a>
    </div>
  </section>
  <section aria-labelledby="publications">
    <h2 id="publications">The publications</h2>
    <div class="catalog">
      {documents.map((doc) => (
        <a class="entry" href={`/${doc.id}/`}>
          <span class="number">0{doc.data.order + 1}</span>
          <div>
            <h3>{doc.data.title}</h3>
            <p>{doc.data.description}</p>
            <span class="status">
              {doc.data.status === "draft"
                ? "Working draft · Read now"
                : "In preparation"}
            </span>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <aside>
    <h2>Current working draft</h2>
    <p>
      The proposed standard and its supporting notes are now available here. No
      governing body has adopted the Standard.
    </p>
    <a href="/standard/overview/">Read the current standard →</a>
  </aside>
</Base>
